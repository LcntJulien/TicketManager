# -----------------------
# OS / system files
# -----------------------
# macOS folder metadata
.DS_Store
# Windows thumbnail cache
Thumbs.db
# Linux swap/temp (if ever)
*~

# -----------------------
# Secrets / env / local config
# -----------------------
# Local env files
.env
.env.local
.env.*.local
# VS Code workspace / settings that might contain local paths or tokens
.vscode/*
# keep recommended extensions ?
!.vscode/extensions.json

# -----------------------
# Editor / IDE
# -----------------------
# Visual Studio Code caches, local state & user files
.history/
*.user
*.suo
.idea/
*.DotSettings.user

# -----------------------
# .NET build artefacts
# -----------------------
bin/
obj/

# -----------------------
# Docker (generic developer files)
# -----------------------
# docker-compose override (local), Docker local build caches
docker-compose.override.yml
.docker/
# local docker envs and secrets
.env.docker
# NOTE: I don't ignore Dockerfiles or compose.yml, only local overrides

# -----------------------
# Logs and temporary files
# -----------------------
# general logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------
# Archives / backups
# -----------------------
# Temporary backup or editor swap files
*.bak
*.tmp
*.swp

# -----------------------
# Database dump/exports (local dev)
# -----------------------
# Avoid accidentally pushing DB dumps
*.sql
*.dump
*.backup

# -----------------------
# Misc
# -----------------------
# OS generated files
.Spotlight-V100
.Trashes
